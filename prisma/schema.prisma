generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReportCategory {
  SECURITY
  HARASSMENT
  CORRUPTION
  TECHNICAL
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModeratorRole {
  MODERATOR
  ADMIN
}

model Report {
  id            String         @id @default(uuid()) @db.Uuid
  caseCodeHash  String         @unique
  category      ReportCategory
  description   String
  evidenceUrl   String?
  status        ReportStatus   @default(SUBMITTED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  closedAt      DateTime?

  statusUpdates StatusUpdate[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model StatusUpdate {
  id         String       @id @default(uuid()) @db.Uuid
  reportId   String       @db.Uuid
  fromStatus ReportStatus
  toStatus   ReportStatus
  message    String?
  createdAt  DateTime     @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Moderator {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  role         ModeratorRole @default(MODERATOR)
  createdAt    DateTime      @default(now())

  auditLogs AuditLog[]
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  moderatorId String     @db.Uuid
  reportId    String?    @db.Uuid
  action      String
  createdAt   DateTime   @default(now())

  moderator Moderator @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  report    Report?   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([moderatorId])
  @@index([reportId])
  @@index([createdAt])
}